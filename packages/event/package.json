{
	"name": "@hexadrop/event",
	"version": "2.1.0",
	"description": "Hexagonal architecture utils library",
	"keywords": [
		"hexadrop",
		"DDD",
		"Hexagonal",
		"Architecture"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hexadrop/hexadrop.git"
	},
	"homepage": "https://github.com/hexadrop/hexadrop",
	"bugs": {
		"url": "https://github.com/hexadrop/hexadrop/issues"
	},
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/domain-event.d.mts",
			"default": "./dist/domain-event.mjs"
		},
		"./bus": {
			"types": "./dist/bus.d.mts",
			"default": "./dist/bus.mjs"
		},
		"./bus/async": {
			"types": "./dist/bus.async.d.mts",
			"default": "./dist/bus.async.mjs"
		},
		"./bus/mock/bun": {
			"types": "./dist/bus.mock-bun.d.mts",
			"default": "./dist/bus.mock-bun.mjs"
		},
		"./bus/mock/vitest": {
			"types": "./dist/bus.mock-vitest.d.mts",
			"default": "./dist/bus.mock-vitest.mjs"
		},
		"./bus/pub-sub": {
			"types": "./dist/bus.pub-sub.d.mts",
			"default": "./dist/bus.pub-sub.mjs"
		},
		"./bus/sync": {
			"types": "./dist/bus.sync.d.mts",
			"default": "./dist/bus.sync.mjs"
		},
		"./decorator": {
			"types": "./dist/decorator.d.mts",
			"default": "./dist/decorator.mjs"
		},
		"./handlers": {
			"types": "./dist/event-handlers.d.mts",
			"default": "./dist/event-handlers.mjs"
		},
		"./handlers/memory": {
			"types": "./dist/in-memory.event-handlers.d.mts",
			"default": "./dist/in-memory.event-handlers.mjs"
		},
		"./handlers/ioc": {
			"types": "./dist/ioc.event-handlers.d.mts",
			"default": "./dist/ioc.event-handlers.mjs"
		}
	},
	"scripts": {
		"prepublishOnly": "tsdown"
	},
	"peerDependencies": {
		"@google-cloud/pubsub": "^4 || ^5.0.0 || ^6.0.0",
		"@hexadrop/ioc": "^2.0.0",
		"p-queue": "^8 || ^9.0.0",
		"vitest": "^1 || ^2.0.0 || ^3.0.0 || ^4.0.0"
	},
	"peerDependenciesMeta": {
		"@google-cloud/pubsub": {
			"optional": true
		},
		"@hexadrop/ioc": {
			"optional": true
		},
		"p-queue": {
			"optional": true
		},
		"vitest": {
			"optional": true
		}
	},
	"dependencies": {
		"@hexadrop/either": "2.0.1",
		"@hexadrop/error": "2.0.0",
		"@hexadrop/types": "2.0.0"
	},
	"devDependencies": {
		"@abraham/reflection": "0.13.0",
		"@google-cloud/pubsub": "6.0.1",
		"@hexadrop/ioc": "2.0.0",
		"diod": "3.0.0",
		"p-queue": "9.3.3",
		"tsdown": "0.23.0",
		"vitest": "4.1.11"
	}
}
