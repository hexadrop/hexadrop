{
	"name": "@hexadrop/types",
	"version": "2.0.0",
	"description": "Hexagonal architecture utils library",
	"keywords": [
		"hexadrop",
		"DDD",
		"Hexagonal",
		"Architecture"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hexadrop/hexadrop.git"
	},
	"homepage": "https://github.com/hexadrop/hexadrop",
	"bugs": {
		"url": "https://github.com/hexadrop/hexadrop/issues"
	},
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		"./abstract": {
			"types": "./dist/abstract.d.mts",
			"default": "./dist/abstract.mjs"
		},
		"./awaitable": {
			"types": "./dist/awaitable.d.mts",
			"default": "./dist/awaitable.mjs"
		},
		"./class": {
			"types": "./dist/class.d.mts",
			"default": "./dist/class.mjs"
		},
		"./instance": {
			"types": "./dist/instance.d.mts",
			"default": "./dist/instance.mjs"
		},
		"./newable": {
			"types": "./dist/newable.d.mts",
			"default": "./dist/newable.mjs"
		},
		"./nullable": {
			"types": "./dist/nullable.d.mts",
			"default": "./dist/nullable.mjs"
		},
		"./primitives": {
			"types": "./dist/primitives.d.mts",
			"default": "./dist/primitives.mjs"
		},
		"./recursive-partial": {
			"types": "./dist/recursive-partial.d.mts",
			"default": "./dist/recursive-partial.mjs"
		}
	},
	"scripts": {
		"prepublishOnly": "tsdown"
	},
	"devDependencies": {
		"tsdown": "0.22.14"
	}
}
