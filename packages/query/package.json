{
	"name": "@hexadrop/query",
	"version": "2.1.0",
	"description": "Hexagonal architecture utils library",
	"keywords": [
		"hexadrop",
		"DDD",
		"Hexagonal",
		"Architecture"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hexadrop/hexadrop.git"
	},
	"homepage": "https://github.com/hexadrop/hexadrop",
	"bugs": {
		"url": "https://github.com/hexadrop/hexadrop/issues"
	},
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/query.d.mts",
			"default": "./dist/query.mjs"
		},
		"./bus": {
			"types": "./dist/bus.d.mts",
			"default": "./dist/bus.mjs"
		},
		"./bus/mock/bun": {
			"types": "./dist/bus.mock-bun.d.mts",
			"default": "./dist/bus.mock-bun.mjs"
		},
		"./bus/mock/vitest": {
			"types": "./dist/bus.mock-vitest.d.mts",
			"default": "./dist/bus.mock-vitest.mjs"
		},
		"./bus/sync": {
			"types": "./dist/bus.sync.d.mts",
			"default": "./dist/bus.sync.mjs"
		},
		"./decorator": {
			"types": "./dist/decorator.d.mts",
			"default": "./dist/decorator.mjs"
		},
		"./handlers": {
			"types": "./dist/query-handlers.d.mts",
			"default": "./dist/query-handlers.mjs"
		},
		"./handlers/memory": {
			"types": "./dist/in-memory.query-handlers.d.mts",
			"default": "./dist/in-memory.query-handlers.mjs"
		},
		"./handlers/ioc": {
			"types": "./dist/ioc.query-handlers.d.mts",
			"default": "./dist/ioc.query-handlers.mjs"
		}
	},
	"scripts": {
		"prepublishOnly": "tsdown"
	},
	"peerDependencies": {
		"@hexadrop/ioc": "^2.0.0",
		"vitest": "^1 || ^2.0.0 || ^3.0.0 || ^4.0.0"
	},
	"peerDependenciesMeta": {
		"@hexadrop/ioc": {
			"optional": true
		},
		"vitest": {
			"optional": true
		}
	},
	"dependencies": {
		"@hexadrop/either": "2.0.1",
		"@hexadrop/error": "2.0.0",
		"@hexadrop/types": "2.0.0"
	},
	"devDependencies": {
		"@abraham/reflection": "0.13.0",
		"@hexadrop/ioc": "2.0.0",
		"diod": "3.0.0",
		"tsdown": "0.22.14",
		"vitest": "4.1.11"
	}
}
