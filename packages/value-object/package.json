{
	"name": "@hexadrop/value-object",
	"version": "2.0.1",
	"description": "Hexagonal architecture utils library",
	"keywords": [
		"hexadrop",
		"DDD",
		"Hexagonal",
		"Architecture"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hexadrop/hexadrop.git"
	},
	"homepage": "https://github.com/hexadrop/hexadrop",
	"bugs": {
		"url": "https://github.com/hexadrop/hexadrop/issues"
	},
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		"./boolean": {
			"types": "./dist/boolean.value-object.d.mts",
			"default": "./dist/boolean.value-object.mjs"
		},
		"./date": {
			"types": "./dist/date.value-object.d.mts",
			"default": "./dist/date.value-object.mjs"
		},
		"./email": {
			"types": "./dist/email.value-object.d.mts",
			"default": "./dist/email.value-object.mjs"
		},
		"./number": {
			"types": "./dist/number.value-object.d.mts",
			"default": "./dist/number.value-object.mjs"
		},
		"./spanish/document-number": {
			"types": "./dist/spanish-document-number.value-object.d.mts",
			"default": "./dist/spanish-document-number.value-object.mjs"
		},
		"./spanish/phone-number": {
			"types": "./dist/spanish-phone-number.value-object.d.mts",
			"default": "./dist/spanish-phone-number.value-object.mjs"
		},
		"./string": {
			"types": "./dist/string.value-object.d.mts",
			"default": "./dist/string.value-object.mjs"
		},
		"./uuii": {
			"types": "./dist/uuii.value-object.d.mts",
			"default": "./dist/uuii.value-object.mjs"
		},
		"./ulid": {
			"types": "./dist/ulid.value-object.d.mts",
			"default": "./dist/ulid.value-object.mjs"
		}
	},
	"scripts": {
		"prepublishOnly": "tsdown"
	},
	"peerDependencies": {
		"ulid": "^2 || ^3.0.0"
	},
	"peerDependenciesMeta": {
		"ulid": {
			"optional": true
		}
	},
	"dependencies": {
		"@hexadrop/error": "2.0.0"
	},
	"devDependencies": {
		"@faker-js/faker": "10.6.0",
		"tsdown": "0.23.0",
		"ulid": "3.0.2"
	}
}
